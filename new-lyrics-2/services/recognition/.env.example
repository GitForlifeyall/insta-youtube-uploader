# ACRCloud Audio Recognition Credentials (Required)
ACRCLOUD_HOST=identify-eu-west-1.acrcloud.com
ACRCLOUD_ACCESS_KEY=your_acrcloud_access_key
ACRCLOUD_ACCESS_SECRET=your_acrcloud_access_secret

# Spotify Authentication (Choose Either Option A or Option B):

# Option A: Your existing SP_DC cookie from the project
SP_DC=your_spotify_sp_dc_cookie_here

# Option B: Official Spotify Developer API keys
# SPOTIFY_CLIENT_ID=your_spotify_client_id
# SPOTIFY_CLIENT_SECRET=your_spotify_client_secret
